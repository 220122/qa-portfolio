+# 文件头（magic number）：只校验扩展名会被"改后缀"绕过，必须看内容
+MAGIC_NUMBERS = {
+    ".pdf": b"%PDF-",        # PDF 文件头
+    ".docx": b"PK\x03\x04",  # docx 本质是 zip，文件头为 PK\x03\x04
