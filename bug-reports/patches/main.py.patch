+def _safe_remove(path: str, retries: int = 3, delay: float = 0.2) -> None:
+    """尽力删除临时文件，绝不因清理失败而掩盖真正的错误。
+
+    Windows 上解析器可能仍持有文件句柄（WinError 32），直接 os.remove 会抛
+    PermissionError，把"用户传了坏文件"（应 400）变成"服务端 500"。所以这里重试
+    并在最终失败时静默放弃——残留文件由运维定期清理，不能让它影响错误码语义。
+    """
+    import time
+
+    for i in range(retries):
+        try:
+            if os.path.exists(path):
+                os.remove(path)
+            return
+        except OSError:
+            if i == retries - 1:
+                return
+            time.sleep(delay)
+
 
