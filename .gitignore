# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.python-version

# ---- 密钥与隐私（绝对不能提交）----
.env
.env.*
*.key
secrets.*
# 真实的用户文档、校内资料、数据集
data/real/
data/raw/
!data/.gitkeep

# ---- 测试产物 ----
# reports/*.md（执行结果、评测集结果）要提交，作为真实执行记录；
# 其余原始产物（junit、html、截图）不提交。
# 注意用 **/ 前缀：否则只匹配仓库根目录下的 reports/，漏掉 api-tests/reports/
**/reports/*.html
**/reports/*.json
**/reports/*.xml
**/allure-results/
**/allure-report/
**/screenshots/*.png
*.log

# ---- 编辑器/IDE ----
.vscode/
.idea/
.DS_Store
Thumbs.db
